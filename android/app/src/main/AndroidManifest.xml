<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AnkiDroid API permission: one per AnkiDroid package id we may talk to
         (stable, GitHub "Parallel" A/B builds, debug builds). -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.A.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.B.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.debug.permission.READ_WRITE_DATABASE" />

    <!-- Media probes: legacy storage read (<= Android 12) and "All files access" (11+). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime game downloads and the self-updater -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updater: hand the downloaded APK to Android's installer (asks "install unknown apps" once). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Floating windows (Team, Pokédex, Shop, Settings, battle) over AnkiDroid: "Display over other apps", asked once. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Floating battle window: a foreground service keeps live detection running while AnkiGo isn't in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reminders (Settings): the alarm that checks them is set again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.ichi2.anki" />
        <package android:name="com.ichi2.anki.A" />
        <package android:name="com.ichi2.anki.B" />
        <package android:name="com.ichi2.anki.debug" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="anki" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AnkiGoApp"
        android:label="AnkiGo"
        android:icon="@drawable/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="35">

        <!-- The game panel: meant for the bottom half of a split screen next to AnkiDroid.
             Don't restart on resize so live detection and the battle animation keep running. -->
        <activity
            android:name=".ui.GameActivity"
            android:theme="@style/GameTheme"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.FirstRunActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.TeamActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.DexActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.ShopActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.StatsActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".help.HelpActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.BattleLogActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.CompareActivity" android:theme="@style/GameTheme" android:exported="false" />

        <!-- The old Study tab: no UI any more (the deck list is the home screen's Study view); forwards old PendingIntents and shortcuts. -->
        <activity
            android:name=".ui.StudyDecksActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- Edit a note's fields from the study card menu (PLAN 70): the keyboard resizes the page, a turned screen keeps the typed text. -->
        <activity
            android:name=".deck.NoteEditActivity"
            android:theme="@style/GameTheme"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Study widget deck picker: the launcher starts it when the widget is added / reconfigured; AnkiGo starts it from "Change deck". -->
        <activity
            android:name=".ui.StudyWidgetSetupActivity"
            android:theme="@style/GameTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Buddy widget Pokémon picker: started by the launcher when the widget is added / reconfigured. -->
        <activity
            android:name=".ui.BuddyWidgetSetupActivity"
            android:theme="@style/GameTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 1x1 Study now widget background picker: started by the launcher when the widget is added / reconfigured. -->
        <activity
            android:name=".ui.StudyNowSetupActivity"
            android:theme="@style/GameTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Motivation widget tap: no UI; opens the Study tab when cards are due, else the battle. -->
        <activity
            android:name=".ui.WidgetTapActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- Runs a file picker for a screen shown in a floating window (no Activity of its own there). -->
        <activity
            android:name=".overlay.ResultActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- Floating battle window (Settings → "When you leave AnkiGo" → Floating battle window). specialUse: no other
             type fits (it follows AnkiDroid answers live), and dataSync is limited to 6 hours a day on Android 15. -->
        <service
            android:name=".overlay.FloatBattleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a floating game window over AnkiDroid that reacts live to the user's flashcard answers; it polls AnkiDroid's content provider once a second while the user studies." />
        </service>

        <!-- Settings -> Diagnostics: the step-0 checks, LIVE watch and the report. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:theme="@style/GameTheme"
            android:label="Diagnostics"
            android:exported="false" />

        <!-- Live watch: meant for the bottom half of a split screen next to AnkiDroid.
             Don't restart on resize so the watch keeps its state. -->
        <activity
            android:name=".LiveWatchActivity"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".StudyActivity"
            android:theme="@style/GameTheme"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Settings → Updates: check for updates, GET UPDATE, GITHUB. -->
        <activity
            android:name=".update.UpdatesActivity"
            android:theme="@style/GameTheme"
            android:label="Updates"
            android:exported="false" />

        <!-- Wide widget: the next wild Pokémon as a silhouette, today's progress, the team. -->
        <receiver
            android:name=".MotivationWidget"
            android:label="AnkiGo: a wild one is waiting"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_motivation" />
        </receiver>

        <!-- Small widget: your main Pokémon with today's progress ring and streak. -->
        <receiver
            android:name=".ui.BuddyWidget"
            android:label="AnkiGo buddy"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_buddy" />
        </receiver>

        <!-- 1x1 widget: "Study now" with the number of cards due; tap opens the Study tab. -->
        <receiver
            android:name=".ui.StudyNowWidget"
            android:label="AnkiGo: Study now"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_study_now" />
        </receiver>

        <receiver
            android:name=".StudyWidget"
            android:label="AnkiGo study"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_study" />
        </receiver>

        <!-- Reminders: the alarm tick (AlarmManager sends it to AnkiGo itself) ... -->
        <receiver android:name=".remind.ReminderReceiver" android:exported="false" />

        <!-- ... the buttons of a reminder notification (In 1 hour, Not today): only AnkiGo's own PendingIntents reach it ... -->
        <receiver android:name=".remind.ReminderActionReceiver" android:exported="false" />

        <!-- ... a tap on a reminder notification and "Study now": no UI; takes the notification away, opens the Study tab (Shop for the shop news). -->
        <activity
            android:name=".remind.ReminderOpenActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- ... and the system events after which Android has forgotten the alarm (the system may send these to a non-exported receiver). -->
        <receiver android:name=".remind.ReminderRearmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Shares the downloaded update APK (in the cache) with Android's package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
