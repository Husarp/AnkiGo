<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AnkiDroid API permission: one per AnkiDroid package id we may talk to
         (stable, GitHub "Parallel" A/B builds, debug builds). -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.A.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.B.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.debug.permission.READ_WRITE_DATABASE" />

    <!-- Media probes: legacy storage read (<= Android 12) and "All files access" (11+). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- MathJax from CDN -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updater: hand the downloaded APK to Android's installer (asks "install unknown apps" once). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.ichi2.anki" />
        <package android:name="com.ichi2.anki.A" />
        <package android:name="com.ichi2.anki.B" />
        <package android:name="com.ichi2.anki.debug" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="anki" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:label="AnkiGo"
        android:icon="@drawable/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="35">

        <!-- The game panel: meant for the bottom half of a split screen next to AnkiDroid.
             Don't restart on resize so live detection and the battle animation keep running. -->
        <activity
            android:name=".ui.GameActivity"
            android:theme="@style/GameTheme"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.FirstRunActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.TeamActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.DexActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.ShopActivity" android:theme="@style/GameTheme" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:theme="@style/GameTheme" android:exported="false" />

        <!-- Settings -> Diagnostics: the step-0 checks, LIVE watch and the report. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:label="Diagnostics"
            android:exported="false" />

        <!-- Live watch: meant for the bottom half of a split screen next to AnkiDroid.
             Don't restart on resize so the watch keeps its state. -->
        <activity
            android:name=".LiveWatchActivity"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".StudyActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Settings → Updates: check for updates, GET UPDATE, GITHUB. -->
        <activity
            android:name=".update.UpdatesActivity"
            android:label="Updates"
            android:exported="false" />

        <!-- Wide widget: the next wild Pokémon as a silhouette, today's progress, the team. -->
        <receiver
            android:name=".MotivationWidget"
            android:label="AnkiGo: a wild one is waiting"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_motivation" />
        </receiver>

        <!-- Small widget: your main Pokémon with today's progress ring and streak. -->
        <receiver
            android:name=".ui.BuddyWidget"
            android:label="AnkiGo buddy"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_buddy" />
        </receiver>

        <receiver
            android:name=".StudyWidget"
            android:label="AnkiGo study"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_study" />
        </receiver>

        <!-- Shares the downloaded update APK (in the cache) with Android's package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
