<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the thumb 3dp thick even if a transition supplies oversized bounds. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="3dp" android:gravity="right|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_scrollbar" />
            <corners android:radius="2dp" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
</layer-list>
