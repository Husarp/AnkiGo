        <!-- upper half: gt-poke #FF6B6B to #D32F35, top to bottom -->
        <path android:pathData="M2.7,11a9.3,9.3 0 0,1 18.6,0Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="12" android:startY="1.7" android:endX="12" android:endY="11">
                    <item android:offset="0" android:color="#FF6B6B" />
                    <item android:offset="1" android:color="#D32F35" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- lower half: gt-bot #FFFFFF to #CFD2E0 -->
        <path android:pathData="M2.7,11a9.3,9.3 0 0,0 18.6,0Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="12" android:startY="11" android:endX="12" android:endY="20.3">
                    <item android:offset="0" android:color="#FFFFFF" />
                    <item android:offset="1" android:color="#CFD2E0" />
