<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn by ui/WidgetRender.kt as two bitmaps (light and dark); this layout shows the dark one (see layout/),
     so a theme change flips the widget without waiting for an update. The card behind is also the fallback before the first draw. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/m_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_game_bg">

    <ImageView
        android:id="@+id/m_img_l"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/m_img_d"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />
</FrameLayout>
