<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GameTheme in Catppuccin Mocha: dark Material parent, light status/navigation bar icons stay off. -->
    <style name="GameTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowBackground">@color/ag_base</item>
        <item name="android:statusBarColor">@color/ag_mantle</item>
        <item name="android:navigationBarColor">@color/ag_mantle</item>
        <item name="android:colorAccent">@color/ag_mauve</item>
        <item name="android:colorPrimary">@color/ag_mantle</item>
        <item name="android:colorPrimaryDark">@color/ag_mantle</item>
        <item name="android:textColorPrimary">@color/ag_text</item>
        <item name="android:textColorSecondary">@color/ag_sub0</item>
    </style>
</resources>
